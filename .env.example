# API endpoint (where mobile app sends requests - laptop IP in dev, domain in prod)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Public URL (used in QR codes, NFC tags, share links - always your domain)
EXPO_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Android Trust Domain (uses API base domain by default, override for other domains)
# EXPO_PUBLIC_ANDROID_TRUST_DOMAIN=bpam.com.my
